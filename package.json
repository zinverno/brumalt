{
  "name": "brumalt",
  "version": "0.3.4",
  "private": true,
  "description": "Free offline memory and logic games for Obsidian.",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "build": "npm run typecheck && node esbuild.config.mjs production && node scripts/package.mjs",
    "verify-package": "node scripts/verify-package.mjs",
    "lint": "eslint . --max-warnings 0"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.6.0",
    "fflate": "0.8.3",
    "jsdom": "26.1.0",
    "obsidian": "1.14.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  },
  "author": "Zinvernix",
  "repository": {
    "type": "git",
    "url": "https://github.com/zinverno/brumalt.git"
  }
}
