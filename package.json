{
  "name": "brumalt",
  "version": "0.3.3",
  "private": true,
  "description": "Free offline memory and logic games for Obsidian.",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "build": "npm run typecheck && node esbuild.config.mjs production && node scripts/package.mjs",
    "verify-package": "node scripts/verify-package.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "obsidian": "1.13.1",
    "typescript": "5.9.3"
  },
  "author": "Zinvernix",
  "repository": {
    "type": "git",
    "url": "https://github.com/zinverno/brumalt.git"
  }
}
